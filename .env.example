# Programa público leído desde Google Sheets
GOOGLE_SHEETS_PROGRAM_CSV_URL=

# Aliados, patrocinadores e instituciones publicados desde la pestaña Aliados
GOOGLE_SHEETS_PARTNERS_CSV_URL=

# Autenticación institucional con Google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Registro general en una hoja privada mediante Google Apps Script
REGISTRATION_API_URL=
REGISTRATION_API_SECRET=

# Neon Postgres para cupos e inscripciones a talleres y concursos
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# Correos autorizados para administrar inscripciones, separados por comas.
# Se comparan en minúsculas; no crea un rol público ni modifica el registro general.
ACTIVITY_ADMIN_EMAILS=

# Coordinadores de staff de registro (dos correos separados por comas).
# Usan sus cuentas Google existentes. Habilitan operadores y asignan sesiones.
# Sin configurar esta lista, el módulo permanece cerrado.
ATTENDANCE_ADMIN_EMAILS=

# Solo local / Preview. Siempre desactivado cuando VERCEL_ENV=production.
ATTENDANCE_SIMULATION_ENABLED=false

# La firma del QR se administra como propiedad privada de Apps Script.
# No contiene información personal; identifica el registro de forma verificable.
